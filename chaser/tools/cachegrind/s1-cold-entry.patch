+/* S1 extension: reset residency at an exact non-PIE guest entry PC.
+   Counters and stock cache access/replacement functions remain unchanged. */
+static ULong clo_s1_cold_entry = 0;
+static ULong s1_reset_count = 0;
+
+static void s1_cold_reset(void)
+{
+   cache_t2* caches[3] = { &I1, &D1, &LL };
+   Int i;
+   for (i = 0; i < 3; i++) {
+      cache_t2* c = caches[i];
+      VG_(memset)(c->tags, 0, sizeof(UWord) * c->sets * c->assoc);
+   }
+   s1_reset_count++;
+   VG_(umsg)("S1 cold reset: entry=0x%llx count=%llu I1,D1,LL\n",
+             clo_s1_cold_entry, s1_reset_count);
+}
 
 static Bool  clo_cache_sim  = True;  /* do cache simulation? */
 static Bool  clo_branch_sim = False; /* do branch simulation? */
