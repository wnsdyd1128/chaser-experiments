+PAD_SEED = 2166136261
+PAD_PRIME = 16777619
+MAX_PAD_ROUNDS = 10_000
+MAX_PAD_TAIL = 1_000_000
+# GCC -O2 fully unrolls short constant loops (K <= 4 on SPARC), which makes the
+# per-round cost depend on K; every padding loop therefore stays a loop.
+UNROLL_NONE = '#pragma GCC unroll 1'
+
+
+def pad_final(rounds: int, state: int = PAD_SEED) -> int:
+    """Return the state after `rounds` of pad = (pad ^ 1) * PAD_PRIME.
+
+    Every round flips the parity, so two rounds are the affine map
+    x -> x*P^2 + s*(P^2 - P) with s fixed by the start parity; powers of that
+    map are composed by squaring so a job's final state needs no per-round loop.
+    """
+    mask = (1 << 32) - 1
+    sign = 1 if state % 2 == 0 else -1
+    base = (PAD_PRIME ** 2 & mask, sign * (PAD_PRIME ** 2 - PAD_PRIME) & mask)
+    total, count = (1, 0), rounds // 2
+    while count:
+        if count & 1:
+            total = (base[0] * total[0] & mask, (base[0] * total[1] + base[1]) & mask)
+        base = (base[0] * base[0] & mask, (base[0] * base[1] + base[1]) & mask)
+        count >>= 1
+    state = (total[0] * state + total[1]) & mask
+    return (state ^ 1) * PAD_PRIME & mask if rounds % 2 else state
+
 
