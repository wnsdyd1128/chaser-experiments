#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
YARDA_DIR=${YARDA_DIR:-/workspace/Yet-Another-Reuse-Distance-Analyzer}
cmake -S "$YARDA_DIR" -B rtems/baseline/build/yarda -DCMAKE_BUILD_TYPE=Release
cmake --build rtems/baseline/build/yarda --target yarda_cpp -j 4
make -C rtems/baseline all analyze YARDA_DIR="$YARDA_DIR"
python3 -m pytest -q tests
