/* Naive transpose B = A^T (a corner turn of real-valued data): rows of A are read, columns of B are written.
 * See rtems/periodic/experiment-guide/INPUTS.md#low-locality-kernels-2026-10. */
INLINE static void kernel_${task_id}(void) {
    for (int i = 0; i < ${rows}; ++i)
        for (int j = 0; j < ${cols}; ++j)
            ${B}[${B_offset} + j * ${B_row} + i * ${B_col}] = ${A}[${A_offset} + i * ${A_row} + j * ${A_col}];
}
/** @brief Transpose A into B on every sweep.
 * @return Word-wise FNV-1a hash of B's first column, computed inside the measured job. */
ANALYZE uint32_t task_job_${task_id}(void) {
    for (int t = 0; t < ${sweeps}; ++t)
        kernel_${task_id}();
    uint32_t h = 2166136261U;
    for (int j = 0; j < ${cols}; ++j)
        h = (h ^ ${B}[${B_offset} + j * ${B_row}]) * 16777619U;
    return h;
}
