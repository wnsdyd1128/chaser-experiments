/* Integer reimplementation of the PolyBench/C 4.2.1 TRMM algorithm.
 * Source: linear-algebra/blas/trmm/trmm.c, kernel_trmm.
 * See rtems/periodic/experiment-guide/INPUTS.md#polybench-kernels-2026-10 for the differences. */
INLINE static void kernel_${task_id}(void) {
    for (int i = 0; i < ${n}; ++i)
        for (int j = 0; j < ${n}; ++j) {
            for (int k = i + 1; k < ${n}; ++k) {
                uint32_t bv = ${B}[${B_offset} + i * ${B_row} + j * ${B_col}];
                uint32_t av = ${A}[${A_offset} + k * ${A_row} + i * ${A_col}];
                uint32_t bw = ${B}[${B_offset} + k * ${B_row} + j * ${B_col}];
                ${B}[${B_offset} + i * ${B_row} + j * ${B_col}] = bv + av * bw;
            }
            uint32_t bv = ${B}[${B_offset} + i * ${B_row} + j * ${B_col}];
            ${B}[${B_offset} + i * ${B_row} + j * ${B_col}] = ${alpha}U * bv;
        }
}
/** @brief Reset B to its initial value, then compute B = ALPHA A^T B in place per sweep (A unit lower triangular).
 * @return Word-wise FNV-1a hash of all of B (row-major), computed inside the measured job. */
ANALYZE uint32_t task_job_${task_id}(void) {
    for (int i = 0; i < ${n}; ++i)
        for (int j = 0; j < ${n}; ++j)
            ${B}[${B_offset} + i * ${B_row} + j * ${B_col}] = ${B_initial}U;
    for (int t = 0; t < ${sweeps}; ++t)
        kernel_${task_id}();
    uint32_t h = 2166136261U;
    for (int i = 0; i < ${n}; ++i)
        for (int j = 0; j < ${n}; ++j)
            h = (h ^ ${B}[${B_offset} + i * ${B_row} + j * ${B_col}]) * 16777619U;
    return h;
}
