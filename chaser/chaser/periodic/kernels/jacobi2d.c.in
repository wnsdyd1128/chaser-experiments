/* Integer reimplementation of the PolyBench/C 4.2.1 JACOBI-2D algorithm.
 * Source: stencils/jacobi-2d/jacobi-2d.c, kernel_jacobi_2d.
 * See rtems/periodic/experiment-guide/INPUTS.md#polybench-kernels-2026-10 for the differences. */
INLINE static void kernel_${task_id}(void) {
    for (int i = 1; i < ${last}; ++i)
        for (int j = 1; j < ${last}; ++j) {
            uint32_t c = ${A}[${A_offset} + i * ${A_row} + j * ${A_col}];
            uint32_t w = ${A}[${A_offset} + i * ${A_row} + (j - 1) * ${A_col}];
            uint32_t e = ${A}[${A_offset} + i * ${A_row} + (j + 1) * ${A_col}];
            uint32_t s = ${A}[${A_offset} + (i + 1) * ${A_row} + j * ${A_col}];
            uint32_t n = ${A}[${A_offset} + (i - 1) * ${A_row} + j * ${A_col}];
            ${B}[${B_offset} + i * ${B_row} + j * ${B_col}] = (c + w + e + s + n) / 5U;
        }
    for (int i = 1; i < ${last}; ++i)
        for (int j = 1; j < ${last}; ++j) {
            uint32_t c = ${B}[${B_offset} + i * ${B_row} + j * ${B_col}];
            uint32_t w = ${B}[${B_offset} + i * ${B_row} + (j - 1) * ${B_col}];
            uint32_t e = ${B}[${B_offset} + i * ${B_row} + (j + 1) * ${B_col}];
            uint32_t s = ${B}[${B_offset} + (i + 1) * ${B_row} + j * ${B_col}];
            uint32_t n = ${B}[${B_offset} + (i - 1) * ${B_row} + j * ${B_col}];
            ${A}[${A_offset} + i * ${A_row} + j * ${A_col}] = (c + w + e + s + n) / 5U;
        }
}
/** @brief Advance the five-point stencil one time step per sweep; state carries across sweeps.
 * @return Word-wise FNV-1a hash of all of A (row-major), computed inside the measured job. */
ANALYZE uint32_t task_job_${task_id}(void) {
    for (int t = 0; t < ${sweeps}; ++t)
        kernel_${task_id}();
    uint32_t h = 2166136261U;
    for (int i = 0; i < ${n}; ++i)
        for (int j = 0; j < ${n}; ++j)
            h = (h ^ ${A}[${A_offset} + i * ${A_row} + j * ${A_col}]) * 16777619U;
    return h;
}
